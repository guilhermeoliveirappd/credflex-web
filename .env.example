# ——— Site ———
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" somente no domínio de produção final. Caso contrário robots.txt bloqueia indexação.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Mostra etiquetas "A validar" e legendas de fotos pendentes. Padrão: ligado em dev, desligado em build de produção.
NEXT_PUBLIC_SHOW_REVIEW_MARKERS=

# ——— Canais oficiais (deixe vazio até confirmação; NÃO use números do site antigo) ———
# Somente dígitos com DDI, ex.: 5518999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ——— Leads ———
# dev (memória, padrão fora de produção) | webhook
LEAD_ADAPTER=dev
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# SOMENTE para testes E2E locais em build de produção. Nunca defina em deploy.
ALLOW_DEV_ADAPTER=

# ——— Segurança ———
RATE_LIMIT_SALT=troque-por-valor-aleatorio

# ——— Analytics (carregado apenas após consentimento) ———
NEXT_PUBLIC_GTM_ID=

# ——— Trabalhe conosco ———
# Sem valor: dev valida e descarta; produção responde 503.
CAREERS_STORAGE=

# ——— Google Maps (seção de localização) ———
# Preferencial: cole o "src" do iframe gerado em Google Maps › Compartilhar › Incorporar um mapa
# (a partir do Perfil da Empresa da CredFlex, para o marcador exato).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
# Alternativa oficial: chave da Maps Embed API (Google Cloud, restrinja por domínio).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
